# Completions
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'  # case-insensitive

# Emacs line editing. Without an explicit choice, zsh picks its keymap from
# $VISUAL/$EDITOR and selects vi mode when the value contains "vi" — which
# "nvim" does, silently breaking ^A/^E/^F and autosuggestion accept.
bindkey -e

# Type a bare directory path (e.g. ..) to cd into it, fish-style
setopt auto_cd

# History (fish-like: shared, deduped)
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_all_dups hist_ignore_space

# Nicer file listing and viewing
if command -v eza >/dev/null 2>&1; then
  alias lt='eza --tree --level=3'
fi
if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
fi

# Tool version manager
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# fzf keybindings + completion (Ctrl-R history, Ctrl-T files, Alt-C cd)
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# Claude Code account routing. The 7peaks work seat is a separate Claude
# subscription, and Claude Code stores exactly one login per CLAUDE_CONFIG_DIR:
# the macOS Keychain entry is named after a hash of this exact path string, so
# spell it one way, here, and nowhere else. Mirrors the per-directory git
# identity split in ~/.config/git/config.
CLAUDE_7PEAKS_CONFIG_DIR="$HOME/.claude-7peaks"
CLAUDE_7PEAKS_TREE="$HOME/Repositories/github.com/7-peaks-software"

claude() {
  local dir="${CLAUDE_CONFIG_DIR:-}"
  # An explicit CLAUDE_CONFIG_DIR always wins; CC_ACCOUNT=personal opts out.
  # (CC_ACCOUNT, not CLAUDE_ACCOUNT — Claude Code owns the CLAUDE_ namespace
  # and propagates those vars to its subprocesses.)
  if [[ -z $dir && ${CC_ACCOUNT:-} != personal && $PWD/ == $CLAUDE_7PEAKS_TREE/* ]]; then
    dir="$CLAUDE_7PEAKS_CONFIG_DIR"
  fi
  # Scoped to the invocation, never exported into the shell. `command` avoids
  # recursing back into this function.
  if [[ -n $dir ]]; then
    CLAUDE_CONFIG_DIR="$dir" command claude "$@"
  else
    command claude "$@"
  fi
}

# Personal account inside a work repo.
alias claude-personal='CC_ACCOUNT=personal claude'

# Fish-like autosuggestions and syntax highlighting (brew packages).
# Syntax highlighting must be sourced last.
[ -r /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -r /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
