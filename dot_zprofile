# Homebrew (Apple Silicon prefix)
eval "$(/opt/homebrew/bin/brew shellenv)"

# ~/.local/bin (user-installed tools)
export PATH="$HOME/.local/bin:$PATH"

# Editor. VISUAL is what tools reach for first, EDITOR the fallback — both
# point at nvim so anything that shells out stays in the terminal.
# VS Code is opened by hand (`code .`), never wired in here.
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
fi

# lazygit resolves its config dir via os.UserConfigDir(), which on macOS is
# ~/Library/Application Support/lazygit — not ~/.config. Point it at the
# XDG-style path so the config lives with everything else.
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"
